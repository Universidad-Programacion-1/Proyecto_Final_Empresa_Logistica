                <TableColumn fx:id="tbcDestino" prefWidth="100.0" text="Destino" />
                <TableColumn fx:id="tbcDescripcion" prefWidth="120.0" text="Descripción" />
                <TableColumn fx:id="tbcFecha" prefWidth="100.0" text="Fecha Est." />
                <TableColumn fx:id="tbcEstado" prefWidth="110.0" text="Estado" />
                <TableColumn fx:id="tbcRepartidor" prefWidth="130.0" text="Repartidor" />
