<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="399.0" prefWidth="367.0" spacing="20.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.proyecto_final_empresa_logistica.viewController.LoginViewController">
    <children>
        <Label fx:id="txtTitleLogin" graphicTextGap="5.0" prefHeight="41.0" prefWidth="130.0" style="-: center;" text="Iniciar Sesion" textAlignment="RIGHT" textOverrun="CENTER_ELLIPSIS">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>
        <Pane prefHeight="274.0" prefWidth="572.0">
            <children>
                <TextField fx:id="txtCorreo" layoutX="128.0" layoutY="23.0" promptText="Ingrese el correo" />
                <Label layoutX="29.0" layoutY="23.0" prefHeight="25.0" prefWidth="58.0" text="Usuario:">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Label>
                <Label layoutX="29.0" layoutY="64.0" prefHeight="25.0" prefWidth="80.0" text="Contraseña:">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Label>
                <TextField fx:id="txtContrasena" layoutX="128.0" layoutY="64.0" promptText="Ingrese la Contraseña" />
                <Button fx:id="btnIniciarSesion" layoutX="93.0" layoutY="137.0" mnemonicParsing="false" onAction="#onIniciarSesion" prefHeight="31.0" prefWidth="130.0" text="Iniciar sesión" />
                <Label fx:id="txtOlvidoContrasena" layoutX="84.0" layoutY="178.0" onMouseClicked="#onOlvidoContrasena" prefHeight="25.0" prefWidth="149.0" text="Olvido la Contraseña?">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Label>
            </children>
        </Pane>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
