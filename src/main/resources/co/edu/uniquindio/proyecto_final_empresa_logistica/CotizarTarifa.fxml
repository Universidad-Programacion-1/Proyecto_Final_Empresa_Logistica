<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER"
      spacing="20"
      xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.proyecto_final_empresa_logistica.viewController.CotizarTarifaViewController">

    <padding>
        <Insets top="30" bottom="30" left="40" right="40"/>
    </padding>

    <children>

        <Label text="Cotizar Envío"
               style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

        <GridPane hgap="15" vgap="15">

            <children>

                <Label text="Origen:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="comboOrigen"
                          promptText="Seleccione ciudad"
                          GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Destino:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <ComboBox fx:id="comboDestino"
                          promptText="Seleccione ciudad"
                          GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Peso (kg):" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="txtPeso" promptText="Ej: 3.5"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Volumen:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <ComboBox fx:id="comboVolumen"
                          GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Prioridad:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <ComboBox fx:id="comboPrioridad"
                          GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            </children>

        </GridPane>

        <Button text="Calcular Tarifa"
                fx:id="btnCalcular"
                onAction="#calcularTarifa"
                style="-fx-font-size: 16px; -fx-background-color: #0d6efd; -fx-text-fill: white;"/>

        <Label fx:id="lblResultado"
               text="Total: $"
               style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    </children>

</VBox>